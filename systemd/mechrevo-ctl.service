[Unit]
Description=MECHREVO Hardware Power and Thermal Control Daemon
After=basic.target systemd-modules-load.service
Before=display-manager.service
Conflicts=power-profiles-daemon.service

[Service]
Type=simple
ExecStart=/usr/local/bin/mechrevo-ctld
Restart=on-failure
RestartSec=3s
User=root

[Install]
WantedBy=multi-user.target
